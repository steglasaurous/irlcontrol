# Your twitch username (used to connect to correct channel)
TWITCH_USERNAME=
# Client ID and Secret - you'll need to setup a new app as a developer in the
# twitch developer console, then add the client id and secret here.
TWITCH_APP_CLIENT_ID=
TWITCH_APP_CLIENT_SECRET=

# Twitch username and oauth token that NOALBS uses to post messages.
# Use this tool to get an oauth token: https://twitchapps.com/tmi/
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=

# OBS connection details - note that websocket server must be enabled in OBS.
OBS_HOST=
OBS_PASSWORD=
OBS_PORT=4455

# OBS Scenes for different states of the IRL stream - change these to the names of your scenes in OBS you want to switch to.
OBS_SCENE_NORMAL=
OBS_SCENE_LOW_BITRATE=
OBS_SCENE_OFFLINE=

# The external-facing URL to get to your site.  I suggest using nip.io to use your IP address.
# You can get your external IP from a service like whatismyip.com - use what it lists for "IPv4"
# An example of a nip.io url if your public ip address is 123.123.123.123
# 123.123.123.123.nip.io
SITE_VIRTUAL_HOST=

# If you want to use HTTPS, provide the same host as above, and an email address that letsencrypt can use
SITE_LETSENCRYPT_HOST=
SITE_LETSENCRYPT_EMAIL=

# If using RealTimeIRL and you wish to record your GPS coordinates to a file, provide your RTIRL pull key.
# Data on coordinates and stream status is written to a text file as json lines in the irlcontrol
# container at /server/data/location_stream_stats.txt
# More about the service: https://rtirl.com/
RTIRL_PULL_KEY=

# If you use belabox cloud to relay your video, add the stats URL and ingest key
# here.
BELABOX_STATS_URL=
BELABOX_INGEST_KEY=

# URL to access local belabox instance, if available.  The client will connect and show individual interface
# bitrate and RTT in the client.
# NOTE: for this to work over HTTPS, belabox also needs a self-signed
# certificate at the minimum.  The user would need to trust the certificate for it to work.
BELABOX_WS_URL=wss://belabox.local
BELABOX_PASSWORD=

# URL to where my custom moblin assistant relay lives. (this is where moblin connects to send its data and receive
# control messages like switching scenes, zoom level, start/stop stream, etc.
MOBLIN_ASSISTANT_WS_URL=
MOBLIN_ASSISTANT_PASSWORD=

# production or development
NODE_ENV=production

# The URL to where the video playlist lives for watching video feedback.
# This generally gets mapped into the container as a volume so only needs changing
# if it's development.
VIDEO_FEEDBACK_SOURCE_URL=/video/stream_0.m3u8


